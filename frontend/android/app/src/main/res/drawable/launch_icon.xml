<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the mark inside the Android 12 system splash mask. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item android:width="168dp" android:height="168dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/launch_logo" />
    </item>
</layer-list>
